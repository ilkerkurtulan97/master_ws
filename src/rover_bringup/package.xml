<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>rover_bringup</name>
  <version>0.1.0</version>
  <description>One-command launch files for the full navigation stack: real robot and Isaac Sim.</description>
  <maintainer email="ilker@todo.com">ilker</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>dynamic_obstacle_detector</exec_depend>
  <exec_depend>navmesh_planner</exec_depend>
  <exec_depend>drive_controller</exec_depend>
  <exec_depend>zed_speed_governor</exec_depend>
  <exec_depend>navmesh_gui</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
