<?xml version="1.0"?>
<package format="3">
  <name>mesh_nav_isaac_sim</name>
  <version>0.1.0</version>
  <description>Launch and config for mesh_navigation stack in Isaac Sim (Bitlab scene)</description>
  <maintainer email="ikurtulan97@gmail.com">ilker</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake_python</buildtool_depend>

  <exec_depend>mbf_mesh_nav</exec_depend>
  <exec_depend>dijkstra_mesh_planner</exec_depend>
  <exec_depend>cvp_mesh_planner</exec_depend>
  <exec_depend>mesh_controller</exec_depend>
  <exec_depend>mesh_layers</exec_depend>
  <exec_depend>mesh_map</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>topic_tools</exec_depend>
  <exec_depend>python3-rclpy</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
